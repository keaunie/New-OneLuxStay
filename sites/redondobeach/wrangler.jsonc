{
  "name": "oneluxstay-redondobeach",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // redondobeach.oneluxstay.com. The hostname must not already have a DNS record in the
  // Cloudflare zone; Cloudflare creates the record when this is deployed.
  "routes": [
    { "pattern": "redondobeach.oneluxstay.com", "custom_domain": true }
  ]
}
