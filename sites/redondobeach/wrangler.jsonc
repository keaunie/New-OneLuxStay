{
  "name": "oneluxstay-redondobeach",
  "main": "./worker.js",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Lets worker.js redirect alternate hostnames before any page is served.
    "run_worker_first": true
  },
  // The main address, plus alternate addresses that redirect to it (see worker.js).
  // Each hostname must not already have a DNS record in the Cloudflare zone; Cloudflare creates
  // the record when this is deployed.
  "routes": [
    { "pattern": "redondobeach.oneluxstay.com", "custom_domain": true },
    { "pattern": "redondo.oneluxstay.com", "custom_domain": true }
  ]
}
