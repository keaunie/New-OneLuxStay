/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' mailto:; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https://assets.guesty.com https://images.unsplash.com https://*.googleusercontent.com; connect-src 'self' https://admin.oneluxstay.com; frame-src 'self' https://www.google.com https://maps.google.com; worker-src 'self' blob:;

/assets/*
  Cache-Control: public, max-age=31536000, immutable
