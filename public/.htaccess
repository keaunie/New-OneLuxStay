# ── Force correct MIME types for Vite ESM output ─────────────────────────────
<FilesMatch "\.js$">
  ForceType application/javascript
</FilesMatch>
<FilesMatch "\.mjs$">
  ForceType application/javascript
</FilesMatch>
<FilesMatch "\.css$">
  ForceType text/css
</FilesMatch>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|mjs)$">
    Header set Content-Type "application/javascript; charset=utf-8"
    Header set X-Content-Type-Options "nosniff"
  </FilesMatch>

  # index.html (and .htaccess itself) must NEVER be served stale — it's what
  # references the current hashed asset filenames. A cached copy pointing at
  # filenames from a previous deploy is exactly what causes a blank white page
  # after re-uploading a new build.
  <FilesMatch "^(index\.html|\.htaccess)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Every build gives JS/CSS/media files under /assets/ a new content hash in
  # their filename, so they're safe to cache forever — a "stale" copy is byte-
  # for-byte identical to the current one, since a real change gets a new name.
  # (<FilesMatch> only sees the basename, so the /assets/ path check happens
  # via the RewriteRule env flag below instead.)
  Header set Cache-Control "public, max-age=31536000, immutable" env=IS_HASHED_ASSET
</IfModule>

# ── SPA routing ───────────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Flag hashed build output for the long-cache header above
  RewriteCond %{REQUEST_URI} ^/assets/
  RewriteRule ^ - [E=IS_HASHED_ASSET:1]

  # Serve real files and directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Never rewrite asset paths
  RewriteRule ^assets/ - [L]

  # React SPA fallback
  RewriteRule ^ /index.html [L]
</IfModule>
