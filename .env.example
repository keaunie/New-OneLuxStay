# AI concierge
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_AI_QUERY_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_ALLOWED_ORIGINS=https://oneluxstay.com,https://www.oneluxstay.com,https://oneluxstayprop.netlify.app,http://localhost:8888,http://localhost:5174
AI_REQUIRE_ORIGIN=true
AI_REQUIRE_USER_AGENT=true
AI_BLOCK_BOT_UA=true
AI_RATE_LIMIT_MAX_REQUESTS=20
AI_RATE_LIMIT_WINDOW_MS=60000
AI_QUERY_ENABLED=false

# Frontend API routing / SEO
VITE_API_BASE=
VITE_NETLIFY_SITE_URL=
VITE_NETLIFY_FUNCTIONS_ORIGIN=
VITE_FORCE_REMOTE_FUNCTIONS=false
VITE_GOOGLE_SITE_VERIFICATION=
VITE_ENABLE_AI_AGENT_CONSOLE=false
VITE_HIDDEN_LISTING_IDS=
VITE_HIDDEN_LISTING_TITLES=

# Guesty fallback + sync credentials
GUESTY_OPEN_API_CLIENT_ID=
GUESTY_OPEN_API_CLIENT_SECRET=
# Legacy names still supported by the functions:
GUESTY_CLIENT_ID=
GUESTY_CLIENT_SECRET=
GUESTY_OPEN_API_HOST=https://open-api.guesty.com
GUESTY_BASE_URL=https://open-api.guesty.com/v1

# Stripe / checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional email receipts
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_RECEIPT_BCC=
RESEND_FALLBACK_TO=

# Supabase core
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_BOOKINGS_TABLE=bookings
SUPABASE_LISTINGS_TABLE=listings
SUPABASE_PROPERTIES_TABLE=properties
SUPABASE_AVAILABILITY_TABLE=listing_nightly_prices
SUPABASE_SECURITY_DEPOSITS_TABLE=security_deposits
SUPABASE_SITE_CONTENT_TABLE=site_content
SUPABASE_SITE_CONTENT_CONCIERGE_KEY=concierge_knowledge
SUPABASE_AI_DOCS_TABLE=documents
SUPABASE_AI_SECTIONS_TABLE=sections
SUPABASE_AI_MATCH_RPC=match_document_sections

# Provider toggles (default keeps existing Guesty behavior)
APP_DATA_PROVIDER=guesty
APP_DATA_PROVIDER_LISTINGS=
APP_DATA_PROVIDER_AVAILABILITY=
APP_DATA_PROVIDER_CONTENT=
APP_DATA_PROVIDER_ENFORCE=false
# Explicit listings source override:
# - `guesty` forces Guesty
# - `supabase` forces Supabase
# - empty = use toggles below
LISTINGS_DATA_PROVIDER=guesty
SUPABASE_USE_FOR_LISTINGS=false
SUPABASE_USE_FOR_AVAILABILITY=false
SUPABASE_USE_FOR_CONTENT=false

# Security deposits lookup cache
SECURITY_DEPOSIT_CACHE_TTL_MS=300000

# Optional sync source overrides
SUPABASE_LISTINGS_SOURCE_ORIGIN=https://oneluxstayprop.netlify.app
SUPABASE_LISTINGS_SOURCE_PATH=/.netlify/functions/listings

# Google Vacation Rentals feed (Hotel List XML)
GOOGLE_VR_FEED_TABLE=properties
GOOGLE_VR_FEED_LANGUAGE=en
GOOGLE_VR_WEBSITE_BASE_URL=https://oneluxstay.com
GOOGLE_VR_DEFAULT_COUNTRY=US
GOOGLE_VR_DEFAULT_PHONE=
GOOGLE_VR_DEFAULT_CATEGORY=vacation_rental
GOOGLE_VR_FEED_PAGE_SIZE=500
GOOGLE_VR_FEED_MAX_ROWS=5000
