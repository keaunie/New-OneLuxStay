# Example environment variables (NO REAL SECRETS).
# Copy to `.env` for local development and fill in values.
# For Netlify deploys, set these in Netlify Site settings > Environment variables.

# Use local Netlify functions in local development.
VITE_API_BASE=/.netlify/functions
VITE_WHATSAPP_NUMBER=16188812613

# Landing circular gallery listing scope (comma-separated IDs, ordered)
VITE_LANDING_GALLERY_LISTING_IDS=

# Guesty credentials (if used)
GUESTY_BE_CLIENT_ID=
GUESTY_BE_CLIENT_SECRET=
GUESTY_OPEN_API_CLIENT_ID=
GUESTY_OPEN_API_CLIENT_SECRET=

# Apaleo credentials (Antwerp PMS)
APALEO_CLIENT_ID=CIIS-SP-ONELUXSTAY
APALEO_CLIENT_SECRET=IIZPbkiVPwe65OrL3M5nwpBROfYLzY
APALEO_ACCOUNT_ID=
# Optional Apaleo overrides
# APALEO_SCOPE=reservations.read availability.read properties.read units.read
# APALEO_IDENTITY_URL=https://identity.apaleo.com
# APALEO_API_BASE=https://api.apaleo.com

# OpenAI (required for chat + conversation summaries)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5-mini
# Optional: separate model for admin conversation summaries
OPENAI_ADMIN_SUMMARY_MODEL=

# Google keys (optional)
GOOGLE_PLACES_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# Stripe (optional, for checkout + webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Website voucher codes (optional)
# Note: voucher codes are applied to Guesty quotes via the Guesty coupons API, so the same coupon code
# must exist in Guesty (e.g. create a coupon named WEB10 in Guesty that applies a 10% discount).
CHECKOUT_VOUCHERS_JSON=[{"code":"WEB10","rate":0.1,"label":"Website 10%"}]
# Legacy single-voucher fallback (optional)
CHECKOUT_DEFAULT_VOUCHER_CODE=
CHECKOUT_DEFAULT_VOUCHER_RATE=0.1

# Twilio WhatsApp (optional, for Lucy on WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_AUTH_TOKEN=
# Multi-region sender lines (US is the default primary sender)
TWILIO_US_WHATSAPP_FROM=whatsapp:+16188812613
TWILIO_US_SMS_FROM=+16188812613
TWILIO_US_VOICE_FROM=+16188812613
TWILIO_BE_WHATSAPP_FROM=whatsapp:+32460254886
TWILIO_BE_SMS_FROM=+32460254886
TWILIO_BE_VOICE_FROM=+32460254886
# Legacy single-line keys are still supported as fallback for compatibility:
# TWILIO_WHATSAPP_FROM=
# TWILIO_WHATSAPP_NUMBER=
# TWILIO_SMS_FROM=
# TWILIO_VOICE_FROM=
# Twilio Voice -> direct VoIP.ms SIP fanout (voice-webhook)
# Optional overrides (defaults are 127056_raph / 127056_angel):
VOIPMS_RAPH_USERNAME=127056_raph
VOIPMS_ANGEL_USERNAME=127056_angel
# Required secrets:
VOIPMS_RAPH_PASSWORD=
VOIPMS_ANGEL_PASSWORD=
# Optional POP override (defaults to atlanta2.voip.ms)
VOIPMS_POP_HOST=atlanta2.voip.ms

# Resend (optional, for email delivery)
RESEND_API_KEY=
RESEND_FROM_EMAIL="OneLuxStay <no-reply@oneluxstay.com>"

# Public site base URL (optional, used for email links in Netlify functions)
PUBLIC_SITE_URL=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Never commit service role keys. Set only in your local `.env` and in Netlify env vars.
SUPABASE_SERVICE_ROLE_KEY=

# Google Vacation Rentals / Hotels feeds (optional)
# Hotel List feed reads listing data from `GOOGLE_VR_FEED_TABLE` (defaults to `properties`).
GOOGLE_VR_FEED_TABLE=properties

# ARI availability/rates should usually read from `property_nightly_prices`.
SUPABASE_AVAILABILITY_TABLE=property_nightly_prices
# Pricing backfill script override (defaults to `property_nightly_prices`).
SUPABASE_PROPERTY_NIGHTLY_PRICES_TABLE=property_nightly_prices

# Admin access controls
ADMINS_OLS_SUPERADMIN_EMAILS=admin@oneluxstay.com
